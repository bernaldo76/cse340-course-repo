
<%- include('partials/header') %>

<main class="content-container">
    <h2>Our Partner Organizations</h2>
    <p>Here are a few of our partner organizations:</p>

    <div class="organizations-list" style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;">

        <% organizations.forEach(organization => { %>
            <div class="org-item" style="display: flex; align-items: center; gap: 15px;">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" style="width: 80px; height: auto;">
                <div>
                    <p><strong><%= organization.name %>:</strong> <%= organization.contact_email %></p>
                    <p><%= organization.description %></p>
                </div>
            </div>
        <% }); %>

    </div>
</main>

<%- include('partials/footer') %>
