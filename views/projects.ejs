
<%- include('partials/header') %>

<section class="content-container">
    <h2>Upcoming Service Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) %>:
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
            </li>
        <% }) %>
    </ul>
</section>

<%- include('partials/footer') %>
