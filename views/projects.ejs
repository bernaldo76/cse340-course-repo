<%- include('partials/header') %>

<section class="content-container">
    <h2>Upcoming Service Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) %>:
                <%= project.title %> (<em><%= project.organization_name %></em>)
            </li>
        <% }) %>
    </ul>
</section>

<%- include('partials/footer') %>